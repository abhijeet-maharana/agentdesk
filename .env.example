# Claude, for typed chat (required)
ANTHROPIC_API_KEY=
# Postgres connection string. Without it chats are kept in memory and lost on restart.
DATABASE_URL=
# Gemini, for live voice calls (optional)
GEMINI_API_KEY=
# Verifies the identity tokens your site signs for logged-in visitors (HS256, 32+ random chars)
IDENTITY_SECRET=
# Protects the /v1/admin API (your team's replies)
ADMIN_TOKEN=
# Slack-compatible incoming webhook for errors (optional)
ALERT_WEBHOOK_URL=
